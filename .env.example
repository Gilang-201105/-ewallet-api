NODE_ENV=development
PORT=3000

# Database (SQLite file-based DB by default; swap to Postgres/MySQL by editing src/config/database.js)
DB_STORAGE=./database.sqlite

# JWT
JWT_SECRET=change_this_super_secret_key
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change_this_super_secret_refresh_key
JWT_REFRESH_EXPIRES_IN=7d

# Background transfer worker
TRANSFER_WORKER_POLL_INTERVAL_MS=2000
